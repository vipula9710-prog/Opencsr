# ---------------------------------------------------------------
# OpenCSR environment configuration. Copy to `.env` and edit.
# Placeholders only — never commit real credentials.
# ---------------------------------------------------------------

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://opencsr:change-me@localhost:5432/opencsr?schema=public"

# Public base URL of this installation (required in production; used for
# canonical URLs, sitemaps, RSS, password-reset links and origin checks)
APP_URL="http://localhost:3000"

# Secret used to sign short-lived tokens (contact-form timing tokens, etc).
# Generate with: openssl rand -base64 48   (minimum 32 characters)
AUTH_SECRET="replace-with-a-long-random-string-of-at-least-32-characters"

# Session lifetime in hours (default 168 = 7 days)
SESSION_TTL_HOURS=168

# --- File storage --------------------------------------------------
# "local" stores files on disk under STORAGE_LOCAL_DIR (good for single-server
# installs and development). "s3" uses any S3-compatible service (AWS S3,
# MinIO, Cloudflare R2, Backblaze B2, Wasabi, ...).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# Maximum upload size in megabytes
UPLOAD_MAX_MB=15

# --- Email (optional) ------------------------------------------------
# Leave SMTP_HOST empty to disable email. Enquiries and notifications are
# always stored and shown in the dashboard regardless.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="OpenCSR <no-reply@example.org>"

# --- Background jobs --------------------------------------------------
# The built-in scheduler publishes scheduled blog posts and sends reminders
# every minute while the server runs. Disable it if you run
# `npm run jobs:run` (or POST /api/jobs/run) from an external cron instead.
ENABLE_INTERNAL_SCHEDULER="true"
# Required to call POST /api/jobs/run with header `Authorization: Bearer <secret>`
JOBS_SECRET=""

# Organisation served on the public website when the request host does not
# match any organisation's configured domain (slug). Optional.
DEFAULT_ORGANISATION_SLUG=""

# Log level: debug | info | warn | error
LOG_LEVEL="info"

# Used by docker-compose.yml for the bundled PostgreSQL container
POSTGRES_PASSWORD="change-me"
