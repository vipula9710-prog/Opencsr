{
  "name": "opencsr",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCSR — free, open-source, self-hostable CSR management and website platform",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && npm run build:scripts",
    "build:scripts": "node scripts/build-scripts.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "db:studio": "prisma studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "demo:remove": "tsx scripts/remove-demo.ts",
    "jobs:run": "tsx scripts/run-jobs.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@prisma/client": "^6.19.3",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "^15.5.27",
    "nodemailer": "^10.1.1",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.9",
    "react-dom": "^19.1.9",
    "recharts": "^2.15.4",
    "sanitize-html": "^2.18.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.17",
    "@types/react-dom": "19.1",
    "@types/sanitize-html": "^2.16.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.4",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "postcss": "^8.5.30",
    "deepmerge-ts": "^8.0.0"
  }
}
